MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 752441878}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ddd593e9e8cf09942a90c9c4f029abd2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1884922112}
  nextButton: {fileID: 1741062551}
  prevButton: {fileID: 294606535}
  endButton: {fileID: 581809435}
  fadeCanvasGroup: {fileID: 1165461064}
  fadeDuration: 2
  dialogueLines:
  - '" I don''t always talk with my mother that much. "'
  - '" Not because we don''t love each other..."'
  - '"...but sometimes it feels like we come from different worlds. "'
  - '" She grew up in Iraq, and I grew up in the Netherlands. "'
  - '" There is a difference between us, in culture and in generation. "'
  - '" But when we cook together, that changes. "'
  - '" Especially when we make dolma. "'
  - '" Ever since I was little, I''ve helped her roll them."'
  - '" Those are the moments when we really talk. "'
  - '" That''s when she tells me about the past, and each time I get to know her
    a little better. "'
  revealSpeed: 0.02
  nextSceneName: DolmaScene
  buttonXOffset: 45
