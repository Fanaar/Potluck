  fadeCanvasGroup: {fileID: 2079107}
  fadeDuration: 2
  dialogueLines:
  - '"When I received the invitation for the potluck, I immediately knew what I wanted
    to bring."'
  - '"Dolma."'
  - "\"We always pick the leaves ourselves\u2026 from the garden.\""
  - '"For as long as I can remember actually."'
  - "\"In spring they are the best\u2026 still soft.\""
  - "\"In summer you have to look more carefully\u2026 some might have already become
    tough.\""
  - '"My mother taught me exactly which ones to choose."'
  revealSpeed: 0.02
  nextSceneName: Grape Leafs Nostalgia
  buttonXOffset: 45
