%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 54346c1d6124c684786b9565e639885c, type: 3}
  m_Name: Round1
  m_EditorClassIdentifier: 
  responses:
  - lines:
    - text: "Mom: i especially miss my mother\u2019s cooking, it was truly the best."
      sprite: {fileID: 21300000, guid: b8340e73f8b75fc49872a5baa48529cf, type: 3}
    - text: 'Mom: the fruit tasted so much better there too.'
      sprite: {fileID: 21300000, guid: 5b069b0162cb57a42b571b35bdd5f1f7, type: 3}
    - text: "Mom: Here you don\u2019t have everything, and what you do have often
        has less flavor."
      sprite: {fileID: 21300000, guid: 56ae68dde5e202442af20615dcf168b2, type: 3}
    - text: 'Mom: i often think about tamr al iraqi, those dates from back then.'
      sprite: {fileID: 21300000, guid: 5a9373ce436dddd41b08b8d197238231, type: 3}
    - text: 'Mom: We had a date palm, and every year a farmer would come to harvest
        it.'
      sprite: {fileID: 21300000, guid: 52c1687365c86714b9bfabd17cecca48, type: 3}
    - text: 'Mom: When he climbed the tree, i would secretly watch from the roof
        because i thought it was so cool.'
      sprite: {fileID: 21300000, guid: 32a04d723892c674fb180f1635571ff1, type: 3}
  - lines:
    - text: 'Mom: i miss my job, my friends, my family, but most of all my mother.'
      sprite: {fileID: 21300000, guid: b8340e73f8b75fc49872a5baa48529cf, type: 3}
    - text: 'Mom: i miss the streets of Baghdad and how alive everything felt there.'
      sprite: {fileID: 21300000, guid: 5b069b0162cb57a42b571b35bdd5f1f7, type: 3}
    - text: 'Mom: When you went outside, there was always something to see, the chaos
        of cars, the honking, the sound of people laughing.'
      sprite: {fileID: 21300000, guid: 56ae68dde5e202442af20615dcf168b2, type: 3}
    - text: 'Mom: it felt like the street was always alive, full of energy.'
      sprite: {fileID: 21300000, guid: fcfa58a935104984581fcd80421f8dde, type: 3}
    - text: 'Mom: i miss the feeling of home, especially the evenings on the roof
        where we would sprinkle water to cool things down and then sleep under the
        stars.'
      sprite: {fileID: 21300000, guid: 52c1687365c86714b9bfabd17cecca48, type: 3}
    - text: 'Mom: the moon seemed bigger there, and in the morning you could feel
        a gentle breeze, and sometimes i think about how we used to walk along the
        Tigris.'
      sprite: {fileID: 21300000, guid: 32a04d723892c674fb180f1635571ff1, type: 3}
