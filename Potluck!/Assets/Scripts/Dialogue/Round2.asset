%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 54346c1d6124c684786b9565e639885c, type: 3}
  m_Name: Round2
  m_EditorClassIdentifier: 
  responses:
  - lines:
    - text: 'Mom: i think i really felt it when i left schiphol.'
      sprite: {fileID: 21300000, guid: b8340e73f8b75fc49872a5baa48529cf, type: 3}
    - text: 'Mom: Everything was so green, almost too green.'
      sprite: {fileID: 21300000, guid: 5b069b0162cb57a42b571b35bdd5f1f7, type: 3}
    - text: 'Mom: Everywhere around us was green, while i was used to yellow in iraq.'
      sprite: {fileID: 21300000, guid: 56ae68dde5e202442af20615dcf168b2, type: 3}
    - text: 'Mom: It immediately felt different, like i was in another world.'
      sprite: {fileID: 21300000, guid: 5a9373ce436dddd41b08b8d197238231, type: 3}
    - text: 'Mom: On that first day, i saw an elderly woman riding a bicycle and
        my heart started beating faster.'
      sprite: {fileID: 21300000, guid: 52c1687365c86714b9bfabd17cecca48, type: 3}
    - text: 'Mom: i honestly thought if she falls now, she will die, because where
        i come from, older women did not do things like that at all.'
      sprite: {fileID: 21300000, guid: 32a04d723892c674fb180f1635571ff1, type: 3}
  - lines:
    - text: 'Mom: the first time i had to leave Iraq, i went to Iran.'
      sprite: {fileID: 21300000, guid: b8340e73f8b75fc49872a5baa48529cf, type: 3}
    - text: 'Mom: Because we were Kurds and connected to the peshmerga, we were expelled
        from the country.'
      sprite: {fileID: 21300000, guid: 5b069b0162cb57a42b571b35bdd5f1f7, type: 3}
    - text: 'Mom: i was ten years old at the time, and they are not pleasant memories.'
      sprite: {fileID: 21300000, guid: 56ae68dde5e202442af20615dcf168b2, type: 3}
    - text: 'Mom: But there was not much to do there, so i started helping with cooking.'
      sprite: {fileID: 21300000, guid: 5a9373ce436dddd41b08b8d197238231, type: 3}
    - text: 'Mom: i learned how to fill kobeh and how to knead bread.'
      sprite: {fileID: 21300000, guid: 52c1687365c86714b9bfabd17cecca48, type: 3}
    - text: 'Mom: that was the first time I really felt like i could help.'
      sprite: {fileID: 21300000, guid: 32a04d723892c674fb180f1635571ff1, type: 3}
